// math_utils.cly - a library written entirely in Calyre.
// Only what is marked `pub` can be used by the files that `use` this one.

func _multiply(a: float, b: float) -> float
    return a * b
end

pub func square(x: float) -> float
    return _multiply(x, x)
end

pub func cube(x: float) -> float
    return _multiply(square(x), x)
end
